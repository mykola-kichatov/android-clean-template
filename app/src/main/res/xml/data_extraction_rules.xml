<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup rules for Android 12 and newer: what goes to the user's Google account
    (cloud-backup) and what moves to a new phone (device-transfer).
    backup_rules.xml has the rules for Android 11 and older. Keep the two files in step.

    Everything the app stores is backed up.
    Keep out what must not come back on another phone, such as a login token, or data
    encrypted with an Android Keystore key, which the new phone cannot decrypt:
    <exclude domain="file" path="datastore/session.preferences_pb" />
-->
<data-extraction-rules>
    <cloud-backup />
    <device-transfer />
</data-extraction-rules>
